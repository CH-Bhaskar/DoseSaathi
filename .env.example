# DoseSaathi — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`
# and NEVER paste real secrets into source code.
#
# WITHOUT VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY the app shows an
# honest NOT-CONFIGURED state: no sign-in, no data, no fake login. There
# is no demo mode any more — the app needs a real Supabase project to do
# anything beyond the language and login screens. See README.md for how
# to create the project and connect it.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable (anon) key — safe to expose in frontend code.
# NEVER put the service_role key here; it bypasses Row Level Security.
VITE_SUPABASE_ANON_KEY=

# Optional: display name shown in the app header (defaults to DoseSaathi)
# VITE_APP_NAME=DoseSaathi

# Voice calls: set to "true" ONLY after the Twilio secrets below are set
# in the Supabase Dashboard AND the Edge Functions are deployed. The
# browser cannot detect the server-side Twilio setup, so this flag is
# the app's honest signal: until it is "true", the call history page
# and the voice settings show "Voice calls are not configured" and no
# call is ever faked. Without Supabase configured, calls are always
# reported as not configured.
# VITE_TWILIO_CONFIGURED=true

# ---------------------------------------------------------------------------
# Voice-call reminders (Twilio) — SERVER SIDE ONLY
# ---------------------------------------------------------------------------
# These values are read ONLY by the Supabase Edge Functions in
# supabase/functions/ (trigger-call). Set them in the Supabase Dashboard →
# Edge Functions → Secrets — never in frontend code, never in a VITE_*
# variable (VITE_* values ship to the browser), and never commit real
# values to git. Until they are set, the app honestly shows
# "Voice calls are not configured" and no call is ever faked.
#
# Twilio Account SID (starts with AC…)
TWILIO_ACCOUNT_SID=
# Twilio Auth Token — treat like a password.
TWILIO_AUTH_TOKEN=
# Twilio phone number that places the calls, E.164 format, e.g. +919999999999
TWILIO_PHONE_NUMBER=
#
# The Edge Functions also need SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY;
# Supabase injects those automatically for deployed functions, so they
# do not belong in this file.
