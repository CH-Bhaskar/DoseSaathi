{
  "$schema": "https://json.schemastore.org/tsconfig",
  "comment": "Type-check only: run `npx tsc --noEmit -p supabase/functions/tsconfig.json` from the repo root. Deno runs the functions directly and does not use this file.",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["."]
}
